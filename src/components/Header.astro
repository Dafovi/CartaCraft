---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navigation, pathTo } from '../data/site';
interface Props { current: string }
const { current } = Astro.props;
---
<header class="site-header shell">
  <a href={pathTo()} class="brand-link" aria-label="CartaCraft — Inicio"><Logo /></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" hidden><span class="menu-lines" aria-hidden="true"></span><span>Menú</span></button>
  <nav id="main-navigation" aria-label="Navegación principal">
    {navigation.map(({ label, path, icon }) => <a href={pathTo(path)} aria-current={current === path ? 'page' : undefined}><Icon name={icon} /><span>{label}</span></a>)}
  </nav>
  <a class="button button-primary header-cta" href={pathTo('proyecto/')}>Conoce la aventura <Icon name="arrow" /></a>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-navigation');
  if (toggle && nav) {
    const media = window.matchMedia('(max-width: 900px)');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.hidden = media.matches && !open;
    };
    toggle.hidden = false;
    setOpen(false);
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
    });
    media.addEventListener('change', () => setOpen(false));
  }
</script>
