---
import Icon from './Icon.astro';
interface Props { title: string; status: string; tone: string; icon: string; text: string }
const { title, status, tone, icon, text } = Astro.props;
---
<article class:list={['status-card', `tone-${tone}`]}>
  <div class="status-top"><span class="status-icon"><Icon name={icon} /></span><div><h3>{title}</h3><span class="badge">{status}</span></div></div>
  <p>{text}</p>
</article>
